{
  "name": "taoqi-pet",
  "version": "0.3.1",
  "description": "A free desktop pet and companion.",
  "private": true,
  "license": "MIT",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "build:ui": "tsc --noEmit && vite build",
    "check": "node scripts/check-app-icons.js && node --check src/electron/main.js && node --check src/electron/update-manager.js && node --check src/electron/version-check.js && node --check src/electron/pet-core.js && node --check src/electron/character-generator.js && node --check src/electron/settings-store.js && node --check src/electron/cutout.js && node --check src/electron/animation/artwork-source.js && node --check src/electron/animation/protocol.js && node --check src/electron/preloads/pet.js && node --check src/electron/preloads/market.js && node --check src/electron/preloads/home.js && node --check tests/electron-smoke.js && tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "smoke": "npm run build:ui && node tests/electron-smoke.js",
    "pack": "npm run build:ui && electron-builder --dir --publish never",
    "dist": "npm run build:ui && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "42.11.12",
    "electron-builder": "26.17.0",
    "playwright": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "author": {
    "name": "Ganzhibin",
    "email": "luli_0819@qq.com"
  },
  "productName": "淘气桌宠",
  "build": {
    "appId": "icu.ganzhibin.taoqipet",
    "productName": "淘气桌宠",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/electron/**",
      "dist-ui/**",
      "assets/**",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "taoqi-pet-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "taoqi-pet-setup-${version}-win-${arch}.${ext}",
      "installerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "taoqi-pet-portable-${version}-win-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Ganzhib",
      "repo": "taoqi-pet",
      "channel": "preview",
      "releaseType": "draft"
    },
    "dmg": {
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "electron-updater": "6.8.9"
  }
}
