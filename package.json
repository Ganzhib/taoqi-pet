{
  "name": "taoqi-pet",
  "version": "0.1.0",
  "description": "A free desktop pet and companion.",
  "private": true,
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/pet-core.js && node --check src/market-preload.js && node --check src/market.js",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "42.11.12",
    "electron-builder": "26.17.0"
  },
  "author": {
    "name": "Ganzhibin",
    "email": "luli_0819@qq.com"
  },
  "productName": "淘气桌宠",
  "build": {
    "appId": "icu.ganzhibin.taoqipet",
    "productName": "淘气桌宠",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Ganzhibin <luli_0819@qq.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
